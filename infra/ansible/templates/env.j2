# SpotBot Environment Configuration
# Generated by Ansible for {{ environment }} environment

# Application
ENVIRONMENT={{ environment }}
DEBUG={{ 'true' if environment == 'dev' else 'false' }}

# Database
DATABASE_URL=postgresql://{{ db_user }}:{{ db_password }}@{{ db_host }}:{{ db_port }}/{{ db_name }}
POSTGRES_USER={{ db_user }}
POSTGRES_PASSWORD={{ db_password }}
POSTGRES_DB={{ db_name }}

# Redis
REDIS_URL=redis://:{{ redis_password }}@{{ redis_host }}:{{ redis_port }}/0

# Security
SECRET_KEY={{ secret_key }}
JWT_SECRET={{ jwt_secret }}
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (adjust for your domain)
CORS_ORIGINS=http://localhost:3000,https://{{ domain }},https://www.{{ domain }}

# AI Detection Services (optional - add your API keys)
OPENAI_API_KEY={{ openai_api_key | default('') }}
ANTHROPIC_API_KEY={{ anthropic_api_key | default('') }}

# Monitoring
SENTRY_DSN={{ sentry_dsn | default('') }}
